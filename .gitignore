# Generated packages, paper translations and scratch outputs stay local.
# Keep the small Casbot02 audit / verification reports reproducible.
/outputs/*
!/outputs/casbot02_data_cleaning/
!/outputs/casbot02_deployment/
!/outputs/casbot02_hardware/
!/outputs/casbot02_sim2sim/
/outputs/casbot02_hardware/*
